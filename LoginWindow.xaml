<Window x:Class="GoupExam.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход" Height="300" Width="400">
    <Grid>
        <TextBox Name="NameTextBox" HorizontalAlignment="Center" VerticalAlignment="Center" Width="200" Height="30"/>
        <Button Name="LoginButton" Content="Войти" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,50" Width="100" Height="30" Click="LoginButton_Click"/>
        <Label Name="ResponseLabel" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10" FontSize="14" Foreground="Green"/>
    </Grid>
</Window>