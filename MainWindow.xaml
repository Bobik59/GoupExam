<Window x:Class="GoupExam.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calorie Info" Height="350" Width="525">
    <Grid>
        <!-- Поле ввода названия продукта или блюда -->
        <TextBox x:Name="InputTextBox" Width="300" Height="30" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="110,0,0,0" />

        <!-- Кнопка для получения данных о продукте -->
        <Button Content="Получить данные о продукте" Click="OnGetProductClick" Width="200" Height="30" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,40,0,0" />

        <!-- Кнопка для получения данных о блюде -->
        <Button Content="Получить данные о блюде" Click="OnGetDishClick" Width="200" Height="30" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="292,45,0,0" RenderTransformOrigin="0.495,0.501" />

        <!-- Текстовое поле для вывода результатов -->
        <TextBox x:Name="OutputTextBox" Width="480" Height="200" Margin="10,94,35,40" VerticalScrollBarVisibility="Auto" IsReadOnly="True" />
    </Grid>
</Window>