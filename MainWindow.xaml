<Window x:Class="GoupExam.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GoupExam"
        mc:Ignorable="d"
        Title="MainWindow" Height="550" Width="1000">
    <Grid>
        <!-- Основная разметка с тремя областями -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <!-- Левая панель с кнопками -->
            <ColumnDefinition/>
            <!-- Центральная область -->
            <ColumnDefinition Width="298"/>
            <!-- Правая панель -->
        </Grid.ColumnDefinitions>

        <!-- Левая панель -->
        <StackPanel Grid.Column="0" Margin="10,10,10,10">
            <Button x:Name="ButtonMenu" Content="Меню" Height="40" Margin="0,10" Click="ButtonMenu_Click"/>
            <Button x:Name="ButtonProducts" Content="Продукты" Height="40" Margin="0,10" IsEnabled="False" Click="ButtonProducts_Click"/>
            <Button x:Name="ButtonDiet" Content="Выбор цели" Height="40" Margin="0,10" IsEnabled="False" Click="ButtonDiet_Click"/>
            <Button x:Name="ButtonForm" Content="Анкета" Height="40" Margin="0,10" Click="ButtonForm_Click"/>
        </StackPanel>

        <!-- Центральная область -->
        <Border Grid.Column="1" Margin="10,10,205,10" BorderBrush="Gray" BorderThickness="1" Grid.ColumnSpan="2">
            <Grid x:Name="CentralArea" Margin="4,1,4,-1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="247*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Добро пожаловать! Выберите действие слева." FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Top" TextWrapping="Wrap" Margin="0,70,0,0" Width="365" />
            </Grid>
        </Border>

        <!-- Правая панель -->
        <Border Grid.Column="2" Margin="93,10,10,10" BorderBrush="Gray" BorderThickness="1">
            <StackPanel Margin="10">
                <TextBlock Text="Ваш список продуктов:" FontSize="14" Margin="0,0,0,10"/>
                <ListBox x:Name="ProductList" Height="250"/>
                <TextBlock Text="Итого калорий:" FontSize="14" Margin="0,10,0,5"/>
                <TextBlock x:Name="TotalCalories" Text="0" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                <Button Content="Удалить продукт" Height="30" Click="RemoveProduct_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

