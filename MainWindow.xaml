<Window x:Class="GoupExam.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calorie Info" Height="350" Width="525">
    <Grid>
        <TextBox x:Name="QueryTextBox" HorizontalAlignment="Left" VerticalAlignment="Top" Width="200" Margin="10" />
        <Button Content="Получить данные о продукте" HorizontalAlignment="Left" VerticalAlignment="Top" Width="200" Height="30" Margin="10,40,0,0" Click="OnGetProductClick"/>
        <Button Content="Получить данные о блюде" HorizontalAlignment="Left" VerticalAlignment="Top" Width="200" Height="30" Margin="10,80,0,0" Click="OnGetDishClick"/>
        <TextBox x:Name="ResultTextBox" HorizontalAlignment="Left" VerticalAlignment="Top" Width="450" Height="150" Margin="10,120,0,0" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" IsReadOnly="True"/>
    </Grid>
</Window>