<Window x:Class="GoupExam.UserDetailsWindow"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация" Height="300" Width="400">
    <Grid Margin="10">
        <StackPanel>
            <TextBlock Text="Введите вес (кг):" Margin="0,10,0,5"/>
            <TextBox Name="WeightTextBox" Height="30"/>

            <TextBlock Text="Введите рост (см):" Margin="0,10,0,5"/>
            <TextBox Name="HeightTextBox" Height="30"/>

            <TextBlock Text="Выберите дату рождения:" Margin="0,10,0,5"/>
            <DatePicker Name="BirthDatePicker" Height="30"/>

            <Button Content="Зарегистрироваться" Name="RegisterButton" Click="RegisterButton_Click" Height="30" Margin="0,20,0,0"/>
            <Label Name="StatusLabel" Foreground="Green" HorizontalAlignment="Center" Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</Window>